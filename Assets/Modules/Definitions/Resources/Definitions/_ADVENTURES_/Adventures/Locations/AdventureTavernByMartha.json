  "Scenes": {
    "scene_01": {
      "Id": "scene_01",
      "Tags": [
        "START",
        "ENTRY",
        "INTRO"
      ],
      "Content": [
        {
          "Type": "Image",
          "Restrictions": [],
          "Value": "",
          "Values": null
        },
        {
          "Type": "Text",
          "Restrictions": [],
          "Value": "Вы оказываетесь перед таверной. Двухэтажный дом из темного дерева стоит чуть в стороне от тракта, будто сам выбрал себе спокойное место. Над дверью покачивается вывеска: «Таверна Приключений». Из трубы тянется дымок, а из-под порога слышен приглушенный гул голосов — не угрожающий, а домашний.",
          "Values": null
        },
        {
          "Type": "Text",
          "Restrictions": [],
          "Value": "С легким скрипом дверь открывается, и вы проходите внутрь.",
          "Values": null
        },
        {
          "Type": "Text",
          "Restrictions": [],
          "Value": "В зале пахнет свежим хлебом, жареным луком и чуть сладковатым элем. Камин на дальней стене роняет свет на столы, карты и старые щиты. За стойкой звенят кружки, у камина кто-то настраивает струны, а воздух кажется густым от тепла и чужих историй, которые здесь рассказывают уже не первый десяток лет.",
          "Values": null
        }
      ],
      "NotClearScene": false,
      "Choices": [
        {
          "Id": "s01_continue",
          "Tags": [],
          "Type": "Default",
          "Text": "Далее…",
          "Description": "",
          "AlwaysShow": true,
